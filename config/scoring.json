  "severity": {
    "_comment": "Severity has two paths. Hard rules force CRITICAL regardless of score, because some conditions are always life-threatening and must not be averaged away. Everything else is the additive weighted score below.",
    "hard_rules": {
      "entanglement": {
        "when": ["entanglement"],
        "reason": "Entanglement in net or line tightens as the animal moves; it is always critical and needs a trained cutting team."
      },
      "wound_with_bleeding": {
        "when": ["wound", "bleeding"],
        "reason": "An actively bleeding wound is critical."
      },
      "respiratory_distress": {
        "when": ["respiratory_distress"],
        "reason": "Laboured or absent breathing is critical."
      },
      "unresponsive": {
        "when": ["unresponsive"],
        "reason": "An unresponsive animal is critical until proven otherwise."
      },
      "cetacean_mobility": {
        "when": ["mobility_concern"],
        "requires_animal_group": "cetacean",
        "reason": "A cetacean that cannot move freely is out of water and will overheat and suffocate under its own weight."
      }
    },
    "scoring_weights": {
      "injury": 1.4,
      "wound": 1.3,
      "bleeding": 1.4,
      "mobility_concern": 1.2,
      "respiratory_distress": 1.5,
      "abnormal_posture": 0.9,
      "swelling": 0.7,
      "near_people": 0.6,
      "near_dogs": 0.5
    },
    "level_thresholds": {
      "critical": 6.5,
      "respond": 3.0,
      "monitor": 1.0
    },
    "weather_adjustment": {
      "multiplier": 0.35,
      "max_points": 0.5
    },
    "confidence": {
      "base": 0.92,
      "incomplete_penalty": 0.25,
      "review_needed_penalty": 0.12,
      "data_conflict_penalty": 0.12,
      "unknown_species_penalty": 0.08,
      "minimum": 0.45
    }
  },
