# LifeJacket configuration.
#
# Copy to `.env` in the repository root and fill in. `.env` is gitignored --
# never commit it.
#
#   cp .env.example .env
#
# Every value here has a working default in backend/lifejacket/config.py, so
# the project runs without a `.env` at all. You only need this file to point at
# a different GCP project, a real database, or to enable Google Maps.

# --- Google Cloud / Vertex AI -------------------------------------------
# Authentication is NOT set here. This file only holds non-secret config --
# there is no key or credential anywhere in this repo.
#
# >>> ONE-TIME SETUP, per developer <<<
#   1. Ask a teammate/admin to grant your UChicago Google account access to
#      the spring-2026-lifejacket GCP project (Vertex AI User role).
#   2. Run once in a terminal:  gcloud auth application-default login
#      (install gcloud first if needed: brew install --cask google-cloud-sdk)
#   3. That's it -- every terminal, notebook, and the API server will pick up
#      your login automatically. Nothing to paste into this file.
GCP_PROJECT=spring-2026-lifejacket
GCP_LOCATION=us-central1

# The model all four agents share. gemini-2.5-flash is the validated default
# the prompts and the token budget below were measured against -- switching
# models is a real behaviour change, not just a config tweak.
#
# Newer "gemini-3.x" model names exist in this GCP project but 404 under
# GCP_LOCATION=us-central1; they currently only resolve under location
# "global". If you switch to one, also set GCP_LOCATION=global and re-measure
# the token budget below (see PROJECT_NOTES.md), since its thinking behaviour
# may differ.
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2

# gemini-2.5-flash spends part of max_output_tokens on internal "thinking"
# before writing the actual JSON reply, and that length varies call to call.
# Uncapped, a long thinking pass can truncate the JSON mid-string -- that is
# what an "Unterminated string" / "Expecting value" JSON error on every retry
# actually is, not a flaky model. Keep max_output_tokens comfortably above
# thinking_budget so there is always real room left for the answer.
#
# Measured live across all four agents' prompts (24 calls): thinking stayed
# at 700-950 tokens, JSON output at 80-600, worst combined total 1429. The
# values below keep real margin over that -- see config.py for the full
# breakdown.
LLM_THINKING_BUDGET=1280
LLM_MAX_OUTPUT_TOKENS=6144
LLM_MAX_RETRIES=3

# --- Storage -------------------------------------------------------------
# SQLite by default, so a new team member can run the stack immediately.
# Swap for Postgres in deployment; the ORM models are unchanged:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/lifejacket
DATABASE_URL=sqlite:///lifejacket.db

# Photos are kept out of the repository: they are large, and a stranding
# location can be personally identifying.
PHOTO_STORAGE_DIR=var/photos

# --- External context APIs -----------------------------------------------
# Open-Meteo (weather, marine) and NOAA CO-OPS (tides) are free and need no
# key, which is why they are the defaults.
#
# Nominatim's usage policy requires a real contact address in the User-Agent
# and allows at most one request per second. Put your own address here.
HTTP_USER_AGENT=LifeJacketDispatch/1.0 (your.email@uchicago.edu)
HTTP_TIMEOUT_SECONDS=10

# Needed only for turn-by-turn navigation in the responder app. Without it the
# map still renders; only driving directions and real ETAs are unavailable.
GOOGLE_MAPS_API_KEY=

# --- Agent behaviour ------------------------------------------------------
# Hard product limit: at most five questions before the agent must commit.
MAX_IDENTIFICATION_QUESTIONS=5
MAX_ASSESSMENT_QUESTIONS=5

# Pooled probability at which a taxon counts as identified -- one species at
# 0.90, or several species in one genus/family summing to 0.90.
#
# TREAT THIS AS UNVALIDATED. In the team's vision research, 50 of 485 answers
# given at 90%+ confidence were wrong, and the strategy comparison used only
# five photos. Every stop decision is logged so this can be calibrated against
# responder ground truth once there is enough of it.
IDENTIFICATION_CONFIDENCE_THRESHOLD=0.90

# Ranks at which identification may stop asking early. Family is accepted
# anyway once no question can separate the species (e.g. common vs bottlenose
# dolphin); add it here to stop at family level straight away.
CONFIDENT_TAXON_RANKS='["species","genus"]'

# --- Maps and routing -----------------------------------------------------
# OpenRouteService draws the driving route from a rescue centre to an incident
# on the console's map. Free key: https://openrouteservice.org/dev/#/signup
#
# Read server-side and never sent to the browser -- the console asks this API
# for routes rather than calling OpenRouteService itself. Without a key the
# map still works, drawing a dashed straight line labelled as such instead of
# a road route.
ORS_API_KEY=

# Map TILES are a separate thing, and are configured in the client, not here:
#   clients/responder_console/.env
#     EXPO_PUBLIC_MAPTILER_KEY=...   (https://maptiler.com, free tier)
#     EXPO_PUBLIC_STADIA_KEY=...     (https://stadiamaps.com, free tier)
#
# Those necessarily reach the browser, since the browser fetches the tiles --
# restrict them by domain in the provider's dashboard. With neither set, the
# map falls back to keyless OpenStreetMap raster tiles, which work but are
# light and bright against the dark console theme.

# --- API server -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
