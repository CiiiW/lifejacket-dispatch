FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY clients/responder_console/package.json clients/responder_console/package-lock.json /app/clients/responder_console/
RUN cd /app/clients/responder_console && npm ci
COPY clients/responder_console /app/clients/responder_console
COPY clients/shared /app/clients/shared

WORKDIR /app/clients/responder_console
# Expo inlines EXPO_PUBLIC_* at build time. This is a same-origin URL, not a secret.
ENV EXPO_PUBLIC_API_URL=/api
ARG EXPO_PUBLIC_MAPTILER_KEY=
ENV EXPO_PUBLIC_MAPTILER_KEY=${EXPO_PUBLIC_MAPTILER_KEY}
RUN npx expo export --platform web

FROM nginx:stable-alpine
COPY deploy/nginx.staging.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/clients/responder_console/dist /usr/share/nginx/html
EXPOSE 80
