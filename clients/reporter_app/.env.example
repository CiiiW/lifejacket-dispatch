# Reporter web: supply public Auth settings only. Never a service-account key.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_REPORTER_PHONE_ENABLED=false
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# Native wrapper opens the approved HTTPS browser app after deployment.
EXPO_PUBLIC_REPORTER_WEB_URL=
# Explicit private legacy demo only; does not verify phone identity.
EXPO_PUBLIC_LEGACY_REPORTER_DEMO=false
