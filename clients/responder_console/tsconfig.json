{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // `expo/tsconfig.base` sets moduleResolution to "node" (node10), which
    // TypeScript now reports as deprecated and drops in 7.0. "bundler" is
    // both current and an accurate description of how Metro resolves.
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@shared/*": ["../shared/*"],
      // `../shared/theme.ts` imports react-native, but it sits outside this
      // app, so the usual node_modules walk-up from its own folder misses
      // this app's copy. Metro already resolves it (see metro.config.js);
      // this is the same mapping for tsc. It names the .d.ts rather than the
      // package folder: since 0.88 react-native publishes its types only
      // through `exports`, which a folder mapping bypasses, landing on
      // untyped index.js. This is the file `exports["."].types` points to.
      "react-native": ["./node_modules/react-native/types_generated/index.d.ts"],
      // `../shared/ConditionsPanel.tsx` is JSX living outside the app, so the
      // JSX runtime's types are not on its resolution path either. Map it to
      // the type definitions, not to react's JS, which would shadow @types.
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      // And for hooks in shared components (TideChart, ConditionsPanel).
      "react": ["./node_modules/@types/react/index.d.ts"]
    }
  }
}
