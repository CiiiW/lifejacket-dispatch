# Copy to `.env` in this folder. Expo only exposes variables prefixed
# EXPO_PUBLIC_, and everything so prefixed ends up in the web bundle -- so
# only put things here that are safe for a browser to hold.

# Where the backend is. Use your machine's LAN IP when testing on a phone,
# because localhost on a phone means the phone.
# EXPO_PUBLIC_API_URL=http://localhost:8000

# --- Map tiles ------------------------------------------------------------
# MapLibre renders the map; these supply the tiles. Set ONE. With neither,
# the console falls back to keyless OpenStreetMap raster tiles: fine for
# development, but light and bright against the dark theme, and OSM's tile
# policy forbids production use.
#
# These keys are fetched by the browser and cannot be hidden. Restrict them
# by domain in the provider dashboard. (The OpenRouteService key, by
# contrast, stays server-side -- it belongs in the repo-root .env.)

# https://cloud.maptiler.com -- free tier, dark "dataviz" style
# EXPO_PUBLIC_MAPTILER_KEY=

# https://client.stadiamaps.com -- free tier, Alidade Smooth Dark
# EXPO_PUBLIC_STADIA_KEY=
